# Example environment variables for the verifier stub
# Never commit real secrets into source control. Use a real secrets manager for production.

SECRET_PEPPER=replace_this_with_a_random_string
# Option A: provide a PEM-formatted private key (PKCS8) as PRIVATE_KEY_PEM
# PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Option B (recommended for on-chain signing): provide raw 32-byte Ed25519 seed as base64
# PRIVATE_KEY_B64_RAW=base64_of_32_byte_seed
PRIVATE_KEY_PEM=replace_with_pem_or_leave_empty
PRIVATE_KEY_B64_RAW=
PACKAGE_ID=0x...   # on-chain Move package id / module id for minting (testnet)
ADMIN_CAP_ID=0x... # admin cap object id if applicable
SUI_RPC=https://rpc.testnet.sui.io:443
PORT=4001
